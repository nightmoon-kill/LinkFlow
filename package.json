{
  "name": "linkflow",
  "version": "1.0.0",
  "description": "Keyword Link Manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac-intel": "electron-builder --mac --x64",
    "build:mac-arm": "electron-builder --mac --arm64",
    "build:mac-universal": "electron-builder --mac --universal",
    "build:win-dir": "electron-builder --win --x64 --dir",
    "build:win-setup": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.yourname.linkflow",
    "productName": "LinkFlow",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "title": "Install LinkFlow",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "dir", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}_Setup_${version}_x64.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}